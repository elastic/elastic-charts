{
  "name": "elastic-charts-mono",
  "description": "Mono repo for @elastic/charts",
  "author": "Elastic DataVis",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": "true",
  "repository": "git@github.com:elastic/elastic-charts.git",
  "scripts": {
    "run:bk:step": "pnpm --filter elastic-charts-buildkite run:step",
    "prepack": "echo 'This package is not published, see packages/*' && exit 1",
    "autoprefix:css": "pnpm --filter @elastic/charts run autoprefix:css",
    "api:check": "pnpm --filter @elastic/charts run api:check",
    "api:check:local": "pnpm --filter @elastic/charts run api:check:local",
    "api:extract": "pnpm --filter @elastic/charts run api:extract",
    "backport": "backport",
    "build": "pnpm --filter @elastic/charts run build",
    "build:ts": "pnpm --filter @elastic/charts run build:ts",
    "build:css": "pnpm --filter @elastic/charts run build:css",
    "build:clean": "pnpm --filter @elastic/charts run build:clean",
    "build:compile": "pnpm --filter @elastic/charts run build:compile",
    "build:check": "pnpm --filter @elastic/charts run build:check",
    "build:sass": "pnpm --filter @elastic/charts run build:sass",
    "build:watch": "pnpm --filter @elastic/charts run build:watch",
    "concat:sass": "pnpm --filter @elastic/charts run concat:sass",
    "cz": "git-cz",
    "lint": "NODE_ENV=production eslint --quiet --ext .tsx,.ts,.mts,.js .",
    "lint:fix": "pnpm lint --fix",
    "lint:it": "NODE_ENV=production eslint --quiet --ext .tsx,.ts,.mts,.js",
    "lint:fix:it": "pnpm lint:it --fix",
    "prettier:check": "prettier --check \"**/*.{json,html,css,scss}\"",
    "prettier:fix": "prettier --w \"**/*.{json,html,css,scss}\"",
    "playground": "RNG_SEED='elastic-charts' pnpm -C playground start",
    "pq": "pretty-quick",
    "semantic-release": "semantic-release --debug",
    "start": "pnpm storybook",
    "storybook": "pnpm -C storybook start",
    "storybook:build": "pnpm -C storybook build",
    "test": "jest --verbose --config jest.config.js",
    "test:pack": "pnpm --filter @elastic/charts run test:pack",
    "test:tz": "pnpm test:tz-utc && pnpm test:tz-ny && pnpm test:tz-jp",
    "test:tz-utc": "TZ=UTC jest --verbose --config=jest.tz.config.js",
    "test:tz-ny": "TZ=America/New_York jest --verbose --config=jest.tz.config.js",
    "test:tz-jp": "TZ=Asia/Tokyo jest --verbose --config=jest.tz.config.js",
    "test:e2e": "pnpm -C e2e test",
    "test:e2e:a11y": "pnpm -C e2e test:a11y",
    "test:e2e:generate": "pnpm test:e2e:generate:examples && pnpm test:e2e:generate:page",
    "test:e2e:generate:examples": "./e2e_server/scripts/extract_examples.sh",
    "test:e2e:generate:page": "./e2e_server/scripts/compile_vrt_page.sh",
    "test:e2e:server": "./e2e_server/scripts/start.sh",
    "test:e2e:svg": "pnpm -C e2e svg:screenshots",
    "test:e2e:svg:review": "pnpm -C e2e svg:review",
    "test:e2e:headless": "pnpm -C e2e headless:screenshots",
    "test:e2e:headless:review": "pnpm -C e2e headless:review",
    "test:e2e:server:build": "pnpm test:e2e:generate && pnpm -C e2e_server/server build",
    "typecheck:base": "tsc -p ./tsconfig.base.json --noEmit",
    "typecheck:e2e": "tsc -p ./e2e/tsconfig.json --noEmit",
    "typecheck:src": "pnpm --filter @elastic/charts run typecheck",
    "typecheck:docs": "pnpm --filter elastic-charts-docs run typecheck",
    "typecheck:storybook": "pnpm --filter charts-storybook run typecheck",
    "typecheck:all": "pnpm typecheck:base && pnpm typecheck:e2e && pnpm typecheck:src && pnpm typecheck:docs && pnpm typecheck:storybook",
    "typedoc": "typedoc",
    "ts:prune": "ts-prune"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@commitlint/cli": "^12.1.1",
    "@commitlint/config-conventional": "^12.1.1",
    "@elastic/charts": "workspace:*",
    "@elastic/datemath": "^5.0.3",
    "@elastic/eui": "^99.2.0",
    "@elastic/eui-theme-borealis": "^3.3.0",
    "@elastic/eui-theme-common": "^3.1.0",
    "@emotion/css": "^11.10.5",
    "@emotion/react": "^11.10.5",
    "@mdx-js/loader": "^1.6.6",
    "@microsoft/api-documenter": "^7.25.4",
    "@microsoft/api-extractor": "^7.47.0",
    "@rsbuild/core": "^2.3.0",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsbuild/plugin-sass": "^1.4.0",
    "@rslib/core": "^1.0.5",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.0",
    "@storybook/react": "^6.5.16",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.2.1",
    "@types/chroma-js": "^2.4.2",
    "@types/classnames": "^2.2.7",
    "@types/color": "^3.0.1",
    "@types/d3-array": "^1.2.6",
    "@types/d3-cloud": "^1.2.5",
    "@types/d3-collection": "^1.0.8",
    "@types/d3-interpolate": "^3.0.1",
    "@types/d3-scale": "^3.3.0",
    "@types/d3-shape": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.121",
    "@types/luxon": "^1.25.0",
    "@types/marked": "^2.0.1",
    "@types/moment-timezone": "^0.5.30",
    "@types/node": "^20.11.0",
    "@types/numeral": "^2.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-redux": "^7.1.20",
    "@types/seedrandom": "^2.4.28",
    "@types/url-parse": "^1.4.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "babel-jest": "^30.0.0",
    "backport": "^5.6.6",
    "change-case": "^4.1.2",
    "classnames": "^2.5.1",
    "commitizen": "^4.2.3",
    "cross-env": "^7.0.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-elastic-charts": "workspace:*",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-file-header": "^0.0.1",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unicorn": "^51.0.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-extended": "^6.0.0",
    "jest-matcher-utils": "^30.0.0",
    "lint-staged": "^10.5.3",
    "lodash": "^4.17.15",
    "lorem-ipsum": "^2.0.3",
    "luxon": "^1.25.0",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.32",
    "numeral": "^2.0.6",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-docgen-typescript-loader": "^3.7.2",
    "react-docgen-typescript-webpack-plugin": "^1.1.0",
    "react-dom": "^18.3.1",
    "sass": "^1.49.9",
    "sass-graph": "^3.0.5",
    "seedrandom": "^3.0.5",
    "semantic-release": "^25.0.3",
    "semantic-release-slack-bot": "^4.0.2",
    "slugify": "^1.5.0",
    "storybook-addon-background-toggle": "^0.0.3",
    "storybook-addon-theme-toggle": "^0.0.1",
    "ts-jest": "^29.4.0",
    "ts-prune": "^0.10.3",
    "typedoc": "^0.25.4",
    "typedoc-plugin-markdown": "^4.0.0-next.36",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "~12.17.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.17.0"
}
